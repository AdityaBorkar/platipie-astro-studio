{
	"name": "platipie-cms",
	"version": "0.1.0",
	"private": true,
	"description": "Standalone content-management server for the Astro site at ASTRO_ROOT — TanStack Start + Bun + Nitro (bun preset).",
	"type": "module",
	"imports": {
		"#/*": "./src/*",
		"#cms/*": "./src/lib/cms/*"
	},
	"scripts": {
		"build": "vite build",
		"check:format": "oxfmt",
		"check:lint": "oxlint",
		"check:tailwind": "bunx tailwind-lint",
		"check:types": "tsrs",
		"clean": "bunx rimraf --glob \"**/{node_modules,.output,.dist,.local.tanstack,bun.lockb}\"",
		"dev": "bun --bun vite dev",
		"gen:routes": "tsr generate",
		"prepare": "husky",
		"preview": "vite preview",
		"start": "bun --bun vite start",
		"test": "bun test",
		"verify": "bun check:format && bun check:lint && bun check:types && bun run build",
		"verify:spec": "bun scripts/verify.ts"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@monaco-editor/react": "4.7.0",
		"@pierre/highlights": "0.2.0",
		"@t3-oss/env-core": "0.13.11",
		"@tanstack/react-devtools": "0.10.13",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-start": "1.169.4",
		"@tiptap/extension-link": "3.32.0",
		"@tiptap/react": "3.32.0",
		"@tiptap/starter-kit": "3.32.0",
		"class-variance-authority": "0.7.1",
		"cn": "0.5.0",
		"diff": "9.0.0",
		"js-yaml": "5.5.0",
		"lucide-react": "1.61.0",
		"marked": "18.1.1",
		"nitro": "3.0.260903-beta",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"rehype-sanitize": "6.0.0",
		"rehype-stringify": "10.0.1",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"sonner": "2.0.8",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"unified": "11.0.5",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@tailwindcss/language-server": "0.16.0",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/router-cli": "1.167.46",
		"@types/bun": "1.4.4",
		"@types/diff": "8.0.0",
		"@types/js-yaml": "4.0.9",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-basic-ssl": "2.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"dotenv": "18.0.9",
		"husky": "9.1.7",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tailwindcss": "1.16.0",
		"react-grab": "0.2.0",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.3.5"
	},
	"engines": {
		"bun": ">=1.1.0"
	}
}
